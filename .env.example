# ==============================================================================
# AVICINNA Platform — Environment Variables Template (.env.example)
# Copy to .env.local (dev) or .env.production (server) and set strong values.
# NEVER commit real .env.local or .env.production files to Git.
# ==============================================================================

# 1. Public Domain & Canonical URL (REQUIRED in production)
# Used for canonical tags, hreflang, sitemap.xml, robots.txt, and CAPI event URLs.
NEXT_PUBLIC_SITE_URL=https://avicinna.com

# 2. Authentication & Session Security (REQUIRED in production)
# Random 32+ char secret for HMAC-SHA256 admin session cookies.
# IMPORTANT: Changing this invalidates active sessions. Never reuse dev secrets.
ADMIN_SECRET=replace_with_64_char_random_hex_secret

# Initial Root Admin Seed (only used the very first time store.json is initialized)
# After first login, manage users, passwords, and TOTP 2FA via /admin/security.
ADMIN_USER=avicinna_core_admin
ADMIN_PASSWORD=replace_with_strong_unique_password

# 3. Persistent Data Directory (STRONGLY RECOMMENDED on Hostinger / VPS deploys)
# Stores store.json, encrypted TOTP/password hashes, uploaded medical reports,
# and Media Library images OUTSIDE the git/deploy folder so redeploys never wipe data.
# Default if omitted: <app_root>/.avicinna-data
AVICINNA_DATA_DIR=/home/your_user/avicinna_persistent_data

# 4. Supabase Database & Storage (OPTIONAL — app works standalone without these)
# When set, CMS data syncs to PostgreSQL and images upload to the 'avicinna-media' bucket.
# When omitted, the app persists reliably to AVICINNA_DATA_DIR/store.json & disk.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 5. AI Translation (OPTIONAL)
# Used by /api/translate (gpt-4o-mini). If omitted, /api/translate automatically falls
# back to free Google Translate -> MyMemory -> built-in medical glossary.
# OPENAI_API_KEY=sk-...

# 6. Instant Lead Alerts (OPTIONAL — can also be configured inside /admin/settings UI)
# RESEND_API_KEY=re_...
# LEAD_ALERT_EMAIL=leads@avicinna.com
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-100...

# 7. Analytics & Pixels (OPTIONAL — can also be configured inside /admin/settings UI)
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# 8. Legacy Optional WordPress Bridge (OPTIONAL — NOT required in production)
# Leave unset or omit when running AVICINNA's built-in Rich-Text CMS.
# WORDPRESS_URL=http://localhost:8080
# NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8080
# WORDPRESS_PREVIEW_SECRET=replace_with_random_webhook_token
